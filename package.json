{
  "name": "curveil",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:web": "pnpm --filter @curveil/web dev",
    "dev:api": "pnpm --filter @curveil/api dev",
    "mainnet:check": "pnpm --filter @curveil/manifest mainnet:check",
    "deploy:mainnet": "pnpm --filter @curveil/manifest deploy:mainnet"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
