{
  "name": "@curveil/broadcaster",
  "private": true,
  "type": "module",
  "description": "Curveil vault broadcaster: pays gas for proof-bound vault transactions. Holds only gas money.",
  "scripts": {
    "dev": "wrangler dev --env testnet --port 8788",
    "deploy:testnet": "wrangler deploy --env testnet",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@curveil/manifest": "workspace:*",
    "hono": "4.13.16",
    "viem": "2.57.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.1"
  }
}
