{
  "name": "@curveil/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-circuits.mjs && vite",
    "build": "tsc --noEmit && node scripts/copy-circuits.mjs && node scripts/pack-sdk.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:testnet": "node scripts/copy-circuits.mjs && node scripts/pack-sdk.mjs && vite build --mode testnet && wrangler deploy --env testnet",
    "circuits": "node scripts/copy-circuits.mjs",
    "sdk": "node scripts/pack-sdk.mjs"
  },
  "dependencies": {
    "@curveil/manifest": "workspace:*",
    "@curveil/sdk": "workspace:*",
    "@curveil/vault-core": "workspace:*",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-wagmi": "1.8.24",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-router": "1.170.46",
    "lightweight-charts": "5.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "snarkjs": "0.7.6",
    "viem": "2.57.14",
    "wagmi": "3.7.9"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.1"
  }
}
