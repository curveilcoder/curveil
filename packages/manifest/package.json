{
  "name": "@curveil/manifest",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./manifests/*": "./manifests/*",
    "./abis/*": "./abis/*"
  },
  "scripts": {
    "build:manifest": "tsx scripts/build-manifest.ts",
    "handover": "tsx scripts/handover.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mainnet:check": "tsx scripts/mainnet-check.ts",
    "deploy:mainnet": "tsx scripts/deploy-mainnet.ts",
    "bind-token": "tsx scripts/bind-token.ts"
  },
  "dependencies": {
    "viem": "2.57.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "@types/node": "24.10.1"
  }
}
